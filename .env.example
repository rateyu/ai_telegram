TELEGRAM_BOT_TOKEN=123456:replace_me

# Your LiteLLM model config:
# - model_name: qwythos-local
# - litellm_params.model: openai/qwythos-local
# - litellm_params.api_base: http://192.168.0.8:4000/v1
# - litellm_params.api_key: sk-none
LITELLM_BASE_URL=http://192.168.0.8:4000/v1
LITELLM_API_KEY=sk-none
LITELLM_MODEL=qwythos-local

# Optional behavior.
BOT_SYSTEM_PROMPT=你是一个简洁、可靠的 Telegram AI 助手。
REQUEST_TIMEOUT_SECONDS=60
MAX_HISTORY_MESSAGES=20
MAX_REPLY_CHARS=3900
