TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_PROXY_URL=

# Your LiteLLM model config:
# - model_name: qwythos-local
# - litellm_params.model: openai/qwythos-local
# - litellm_params.api_base: http://192.168.0.8:4000/v1
# - litellm_params.api_key: sk-none
LITELLM_BASE_URL=http://192.168.0.8:4000/v1
LITELLM_API_KEY=sk-none
LITELLM_MODEL=qwythos-local

# Optional behavior.
BOT_SYSTEM_PROMPT=你是一个简洁、可靠的 Telegram AI 助手。
REQUEST_TIMEOUT_SECONDS=60
MAX_HISTORY_MESSAGES=20
MAX_REPLY_CHARS=3900
MAX_MODEL_TOKENS=
REQUEST_RETRIES=2
RETRY_BACKOFF_SECONDS=2

# Home machine power control (wake/sleep via home_machines.py, exposed as an LLM tool and
# as /wake /sleep commands). Leave TELEGRAM_ADMIN_USER_IDS empty to disable the feature.
# Get your Telegram numeric user id from @userinfobot.
TELEGRAM_ADMIN_USER_IDS=
HM_SCRIPT_PATH=/Users/myu/github/homemachines/home_machines.py
HM_MACHINES_CONFIG=/Users/myu/github/homemachines/machines.json
HM_PYTHON_BIN=
HM_COMMAND_TIMEOUT_SECONDS=150
